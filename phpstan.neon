includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app/

    level: 6

    treatPhpDocTypesAsCertain: false

    ignoreErrors:
        # JsonResource proxies model properties via __get; PHPStan cannot see them.
        - path: app/Http/Resources/CreatedUserResource.php
          message: '#Access to an undefined property App\\Http\\Resources\\CreatedUserResource::#'
        - path: app/Http/Resources/ListedUserResource.php
          message: '#Access to an undefined property App\\Http\\Resources\\ListedUserResource::#'
